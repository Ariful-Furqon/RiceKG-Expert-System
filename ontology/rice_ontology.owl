<owl:NamedIndividual rdf:about="#Brown_Nymphs">
  <rdf:type rdf:resource="#OrganismSighting"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Observation term 'Brown Nymphs': organism sighting.</rdfs:comment>
  <rdfs:label xml:lang="en">brown nymphs</rdfs:label>
  <core:prefLabel xml:lang="en">brown nymphs</core:prefLabel>
  <core:prefLabel xml:lang="id">nimfa cokelat</core:prefLabel>
  <core:definition xml:lang="en">Brown-coloured nymphs (immature, wingless insect stages) seen on the plant, usually at the base of tillers or on lower leaf sheaths.</core:definition>
  <core:scopeNote xml:lang="en">Records the insect, not plant damage. Colour-specific variant of Nymphs_Present; use Nymphs_Present when colour is not reported.</core:scopeNote>
  <core:editorialNote xml:lang="en">Operational definition reviewed and judged adequate by an independent agronomist (reviewer R1, RiceKG multi-rater study, September 2026).</core:editorialNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Yellow_Nymphs">
  <rdf:type rdf:resource="#OrganismSighting"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Observation term 'Yellow Nymphs': organism sighting.</rdfs:comment>
  <rdfs:label xml:lang="en">yellow nymphs</rdfs:label>
  <core:prefLabel xml:lang="en">yellow nymphs</core:prefLabel>
  <core:prefLabel xml:lang="id">nimfa kuning</core:prefLabel>
  <core:definition xml:lang="en">Yellow- or pale-coloured nymphs (immature, wingless insect stages) seen on the plant.</core:definition>
  <core:scopeNote xml:lang="en">Colour-specific variant of Nymphs_Present; use Nymphs_Present when colour is not reported.</core:scopeNote>
  <core:editorialNote xml:lang="en">Operational definition reviewed and judged adequate by an independent agronomist (reviewer R1, RiceKG multi-rater study, September 2026).</core:editorialNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Eggs_On_Plant">
  <rdf:type rdf:resource="#OrganismSighting"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Observation term 'Eggs On Plant': organism sighting.</rdfs:comment>
  <rdfs:label xml:lang="en">insect eggs on plant</rdfs:label>
  <core:prefLabel xml:lang="en">insect eggs on plant</core:prefLabel>
  <core:prefLabel xml:lang="id">telur serangga pada tanaman</core:prefLabel>
  <core:definition xml:lang="en">Insect eggs or egg masses deposited on leaf blades or leaf sheaths and visible without dissection.</core:definition>
  <core:scopeNote xml:lang="en">Excludes nematode egg masses inside root tissue, which are not field-visible.</core:scopeNote>
  <core:editorialNote xml:lang="en">Operational definition reviewed and judged adequate by an independent agronomist (reviewer R1, RiceKG multi-rater study, September 2026).</core:editorialNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Broad_Leaf_Damage">
  <rdf:type rdf:resource="#Symptom"/>
  <rdf:type rdf:resource="#LeafSign"/>
  <rdf:type rdf:resource="#MechanicalDamage"/>
  <rdf:type rdf:resource="#InsectDamageSign"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Observation term 'Broad Leaf Damage': plant symptom; anatomical axis LeafSign; phenomenological axis MechanicalDamage; insect damage, out of diagnostic scope.</rdfs:comment>
  <rdfs:label xml:lang="en">broad leaf damage</rdfs:label>
  <core:prefLabel xml:lang="en">broad leaf damage</core:prefLabel>
  <core:prefLabel xml:lang="id">kerusakan daun luas</core:prefLabel>
  <core:definition xml:lang="en">Loss of a large part of the leaf blade to insect feeding, leaving much of the blade missing.</core:definition>
  <core:scopeNote xml:lang="en">Use Leaf_Chewing_Damage for localized notches or holes.</core:scopeNote>
  <core:editorialNote xml:lang="en">Operational definition reviewed and judged adequate by an independent agronomist (reviewer R1, RiceKG multi-rater study, September 2026).</core:editorialNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Severed_Panicles">
  <rdf:type rdf:resource="#Symptom"/>
  <rdf:type rdf:resource="#PanicleSign"/>
  <rdf:type rdf:resource="#MechanicalDamage"/>
  <rdf:type rdf:resource="#InsectDamageSign"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Observation term 'Severed Panicles': plant symptom; anatomical axis PanicleSign; phenomenological axis MechanicalDamage; insect damage, out of diagnostic scope.</rdfs:comment>
  <rdfs:label xml:lang="en">severed panicles</rdfs:label>
  <core:prefLabel xml:lang="en">severed panicles</core:prefLabel>
  <core:prefLabel xml:lang="id">malai terpotong</core:prefLabel>
  <core:definition xml:lang="en">Panicles or panicle branches cut off at the neck or peduncle by insect feeding.</core:definition>
  <core:scopeNote xml:lang="en">A mechanical cut, not a lesion; use Panicle_Neck_Rot when the neck is necrotic and the panicle remains attached.</core:scopeNote>
  <core:editorialNote xml:lang="en">Operational definition reviewed and judged adequate by an independent agronomist (reviewer R1, RiceKG multi-rater study, September 2026).</core:editorialNote>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Leaf_Chewing_Damage">
