<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/ontologies/rice_pest_disease.owl"
         xmlns="http://www.semanticweb.org/ontologies/rice_pest_disease.owl#"
         xmlns:term="http://purl.org/dc/terms/"
         xmlns:vann="http://purl.org/vocab/vann/"
         xmlns:core="http://www.w3.org/2004/02/skos/core#">

<owl:Ontology rdf:about="http://www.semanticweb.org/ontologies/rice_pest_disease.owl">
  <term:license rdf:resource="https://opensource.org/licenses/MIT"/>
  <term:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RiceKG: an OWL 2 DL ontology for rice disease diagnosis</term:title>
  <term:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RiceKG Expert System contributors</term:creator>
  <term:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Six in-scope rice disease classes (five pathogens and one plant-parasitic nematode) defined by OWL 2 defined classes over a two-axis symptom taxonomy; insect damage is represented as out-of-scope evidence.</term:description>
  <vann:preferredNamespacePrefix rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ricekg</vann:preferredNamespacePrefix>
  <vann:preferredNamespaceUri rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.semanticweb.org/ontologies/rice_pest_disease.owl#</vann:preferredNamespaceUri>
  <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2.4.0</owl:versionInfo>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RiceKG: OWL 2 DL ontology for rice disease diagnosis with defined classes, a symptom taxonomy and provable tier subsumption.</rdfs:comment>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#hasObservation">
  <rdfs:domain rdf:resource="#Rice"/>
  <rdfs:range rdf:resource="#Observation"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Associates a rice plant sample with an observed field sign or context.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSymptom">
  <rdfs:subPropertyOf rdf:resource="#hasObservation"/>
  <rdfs:domain rdf:resource="#Rice"/>
  <rdfs:range rdf:resource="#Symptom"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Associates a rice plant sample with a plant pathological symptom.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasOrganismSighting">
  <rdfs:subPropertyOf rdf:resource="#hasObservation"/>
  <rdfs:domain rdf:resource="#Rice"/>
  <rdfs:range rdf:resource="#OrganismSighting"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Associates a rice plant sample with an observed organism presence.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasVectorSighting">
  <rdfs:subPropertyOf rdf:resource="#hasObservation"/>
  <rdfs:domain rdf:resource="#Rice"/>
  <rdfs:range rdf:resource="#VectorSighting"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Associates a rice plant sample with an observed insect vector presence.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasEpidemiologicalContext">
  <rdfs:subPropertyOf rdf:resource="#hasObservation"/>
  <rdfs:domain rdf:resource="#Rice"/>
  <rdfs:range rdf:resource="#EpidemiologicalContext"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Associates a rice plant sample with stand-level epidemiological context.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasThreat">
  <rdfs:domain rdf:resource="#Rice"/>
  <rdfs:range rdf:resource="#Threat"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inferred threat affecting the rice plant individual.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasConfirmedThreat">
  <rdfs:subPropertyOf rdf:resource="#hasThreat"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">High-specificity, pathognomonic diagnostic inference (Tier 1).</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSuspectedThreat">
  <rdfs:subPropertyOf rdf:resource="#hasThreat"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">High-sensitivity, partial scouting diagnostic inference (Tier 2).</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDisease">
  <rdfs:subPropertyOf rdf:resource="#hasThreat"/>
  <rdfs:domain rdf:resource="#Rice"/>
  <rdfs:range rdf:resource="#Disease"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unstratified link from a rice sample to an inferred disease (flat single-tier baseline).</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasPest">
  <rdfs:subPropertyOf rdf:resource="#hasThreat"/>
  <rdfs:domain rdf:resource="#Rice"/>
  <rdfs:range rdf:resource="#Pest"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unstratified link from a rice sample to an inferred pest (flat single-tier baseline).</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasConfirmedDisease">
  <rdfs:subPropertyOf rdf:resource="#hasConfirmedThreat"/>
  <rdfs:subPropertyOf rdf:resource="#hasDisease"/>
  <rdfs:domain rdf:resource="#Rice"/>
  <rdfs:range rdf:resource="#Disease"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tier-1 (confirmed) inference of a disease.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSuspectedDisease">
  <rdfs:subPropertyOf rdf:resource="#hasSuspectedThreat"/>
  <rdfs:subPropertyOf rdf:resource="#hasDisease"/>
  <rdfs:domain rdf:resource="#Rice"/>
  <rdfs:range rdf:resource="#Disease"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tier-2 (suspected) inference of a disease.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasConfirmedPest">
  <rdfs:subPropertyOf rdf:resource="#hasConfirmedThreat"/>
  <rdfs:subPropertyOf rdf:resource="#hasPest"/>
  <rdfs:domain rdf:resource="#Rice"/>
  <rdfs:range rdf:resource="#Pest"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tier-1 (confirmed) inference of a pest.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSuspectedPest">
  <rdfs:subPropertyOf rdf:resource="#hasSuspectedThreat"/>
  <rdfs:subPropertyOf rdf:resource="#hasPest"/>
  <rdfs:domain rdf:resource="#Rice"/>
  <rdfs:range rdf:resource="#Pest"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tier-2 (suspected) inference of a pest.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasControlTreatment">
  <rdfs:domain rdf:resource="#Threat"/>
  <rdfs:range rdf:resource="#ControlTreatment"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Links a diagnosed threat to its cited IPM recommendation.</rdfs:comment>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasDiagnosticConfidence">
  <rdfs:domain rdf:resource="#Rice"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Datatype property recording the diagnostic confidence grade (confirmed, suspected, possible).</rdfs:comment>
</owl:DatatypeProperty>

<owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch"/>

<owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch"/>

<owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#broadMatch"/>

<owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#relatedMatch"/>

<owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>

<owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>

<owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>

<owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#scopeNote"/>

<owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#editorialNote"/>

<owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>

<owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>

<owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>

<owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>

<owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>

<owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>

<owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>

<owl:Class rdf:about="#Rice">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <core:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_5438"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oryza sativa plant individual under diagnosis.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Observation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Top-level entity for any empirical observation made in a rice field or scout report.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Symptom">
  <rdfs:subClassOf rdf:resource="#Observation"/>
  <core:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_7566"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Direct plant sign or phenotypic manifestation of biotic injury on Oryza sativa.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#OrganismSighting">
  <rdfs:subClassOf rdf:resource="#Observation"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Direct physical sighting of an insect or pest organism (adults, nymphs, egg clutches, frass).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#VectorSighting">
  <rdfs:subClassOf rdf:resource="#Observation"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Entomological sighting of a known insect vector of viral phytopathogens.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EpidemiologicalContext">
  <rdfs:subClassOf rdf:resource="#Observation"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stand-level, environmental, or temporal condition modulating outbreak probability.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LeafSign">
  <rdfs:subClassOf rdf:resource="#Symptom"/>
  <core:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/PO_0025034"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pathological sign manifested on the leaf blade or sheath.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#StemSign">
  <rdfs:subClassOf rdf:resource="#Symptom"/>
  <core:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/PO_0009047"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pathological sign manifested on the culm or tiller stem.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RootSign">
  <rdfs:subClassOf rdf:resource="#Symptom"/>
  <core:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/PO_0009005"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pathological sign manifested on the root system or subterranean crowns.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PanicleSign">
  <rdfs:subClassOf rdf:resource="#Symptom"/>
  <core:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/PO_0009049"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pathological sign manifested on the inflorescence, panicle neck, or rachis.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GrainSign">
  <rdfs:subClassOf rdf:resource="#Symptom"/>
  <core:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/PO_0009010"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pathological sign manifested on the spikelet, caryopsis, or mature grain.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#WholePlantSign">
  <rdfs:subClassOf rdf:resource="#Symptom"/>
  <core:relatedMatch rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Systemic sign manifested across the entire rice plant architecture.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Chlorosis">
  <rdfs:subClassOf rdf:resource="#Symptom"/>
  <core:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_1579"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Foliar yellowing, discoloration, or loss of chlorophyll pigments.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Necrosis">
  <rdfs:subClassOf rdf:resource="#Symptom"/>
  <core:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_15509"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Localized or extensive death and breakdown of plant cells and tissues.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Stunting">
  <rdfs:subClassOf rdf:resource="#Symptom"/>
  <core:exactMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_4426a431"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Suppression of plant elongation, height reduction, or dwarfing.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MechanicalDamage">
  <rdfs:subClassOf rdf:resource="#Symptom"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical perforation, chewing, severance, or feeding injury.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#GrainAbnormality">
  <rdfs:subClassOf rdf:resource="#Symptom"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spikelet sterility, empty glumes, spore replacement, or grain spotting.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#OutOfScopeSign">
  <rdfs:subClassOf rdf:resource="#Symptom"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sign associated with threats outside the primary diagnostic scope of the six core diseases.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InsectDamageSign">
  <rdfs:subClassOf rdf:resource="#OutOfScopeSign"/>
  <rdfs:subClassOf rdf:resource="#MechanicalDamage"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Damage symptom caused specifically by insect feeding.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Threat">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Biotic causal agent (pathogen or parasitic pest) inflicting economic injury on rice.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Disease">
  <rdfs:subClassOf rdf:resource="#Threat"/>
  <core:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_5962"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Infectious disease of rice caused by fungal, bacterial, or viral phytopathogens.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Pest">
  <rdfs:subClassOf rdf:resource="#Threat"/>
  <core:closeMatch rdf:resource="http://aims.fao.org/aos/agrovoc/c_5741"/>
  <owl:disjointWith rdf:resource="#Disease"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Animal or nematode pest infesting rice crops.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ControlTreatment">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Integrated Pest Management (IPM) recommendation or intervention for managing a threat.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Rice_Root_NematodeSuspect">
  <rdfs:subClassOf rdf:resource="#Rice"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <owl:Class>
          <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#Rice"/>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#hasObservation"/>
              <owl:hasValue rdf:resource="#Hook_Like_Root_Swelling"/>
            </owl:Restriction>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#hasObservation"/>
              <owl:hasValue rdf:resource="#Stunted_Growth"/>
            </owl:Restriction>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#hasObservation"/>
              <owl:hasValue rdf:resource="#Yellowing_Leaves"/>
            </owl:Restriction>
          </owl:intersectionOf>
        </owl:Class>
        <owl:Class>
          <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#Rice"/>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#hasObservation"/>
              <owl:hasValue rdf:resource="#Hook_Like_Root_Swelling"/>
            </owl:Restriction>
          </owl:intersectionOf>
        </owl:Class>
        <owl:Class>
          <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#Rice"/>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#hasObservation"/>
              <owl:hasValue rdf:resource="#Root_Knot_Swelling"/>
            </owl:Restriction>
          </owl:intersectionOf>
        </owl:Class>
      </owl:unionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasSuspectedThreat"/>
      <owl:hasValue rdf:resource="#Rice_Root_Nematode"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tier 2 definition for suspected Rice_Root_Nematode: union of rules SWRL-R12, SWRL-R21, SWRL-R22.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Rice_Root_NematodeConfirmed">
  <rdfs:subClassOf rdf:resource="#Rice"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Rice"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasObservation"/>
          <owl:hasValue rdf:resource="#Hook_Like_Root_Swelling"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasObservation"/>
          <owl:hasValue rdf:resource="#Stunted_Growth"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasObservation"/>
          <owl:hasValue rdf:resource="#Yellowing_Leaves"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasObservation"/>
          <owl:hasValue rdf:resource="#Root_Knot_Swelling"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasObservation"/>
          <owl:hasValue rdf:resource="#Deformed_Roots"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasConfirmedThreat"/>
      <owl:hasValue rdf:resource="#Rice_Root_Nematode"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tier 1 pathognomonic definition for confirmed Rice_Root_Nematode.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Rice_Root_NematodeObservation">
  <rdfs:subClassOf rdf:resource="#Observation"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Defined grouping of the Tier-2 antecedent observations of Rice_Root_Nematode.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Rice_Root_NematodePossible">
  <rdfs:subClassOf rdf:resource="#Rice"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Rice"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasObservation"/>
          <owl:onClass rdf:resource="#Rice_Root_NematodeObservation"/>
          <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Qualified cardinality definition (min 2) for possible Rice_Root_Nematode.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Bacterial_Leaf_BlightSuspect">
  <rdfs:subClassOf rdf:resource="#Rice"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Rice"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasObservation"/>
          <owl:hasValue rdf:resource="#Water_Soaked_Lesions"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasObservation"/>
          <owl:hasValue rdf:resource="#Yellowing_Leaf_Tips"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasSuspectedThreat"/>
      <owl:hasValue rdf:resource="#Bacterial_Leaf_Blight"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tier 2 definition for suspected Bacterial_Leaf_Blight: union of rules SWRL-R16.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Bacterial_Leaf_BlightConfirmed">
  <rdfs:subClassOf rdf:resource="#Rice"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Rice"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasObservation"/>
          <owl:hasValue rdf:resource="#Water_Soaked_Lesions"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasObservation"/>
          <owl:hasValue rdf:resource="#Yellowing_Leaf_Tips"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasObservation"/>
          <owl:hasValue rdf:resource="#Yellowing_Leaf_Veins"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasObservation"/>
          <owl:hasValue rdf:resource="#Leaf_Discoloration_Yellow"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasObservation"/>
          <owl:hasValue rdf:resource="#Uniform_Field_Infection"/>
        </owl:Restriction>
        <owl:Restriction>
